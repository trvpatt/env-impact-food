# Copy to .env for local development. Never commit .env.
# Every value here is read by backend/app/core/config.py.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Postgres (matches infra/docker-compose.yml). SQLite also works for quick local runs:
#   DATABASE_URL=sqlite:///./rooted.db
DATABASE_URL=postgresql+psycopg://rooted:rooted@localhost:5432/rooted

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Browsers only send Secure cookies over HTTPS; set false for plain-http localhost.
COOKIE_SECURE=false

CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# SMTP. Mailpit from infra/docker-compose.yml listens on 1025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
EMAIL_FROM=Rooted <no-reply@localhost>

# CAPTCHA. This is Cloudflare Turnstile's always-pass test secret.
CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
CAPTCHA_SECRET=1x0000000000000000000000000000000AA

# Stripe (test-mode keys from the Stripe dashboard).
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
# Used by scripts/seed_reference_data.py: plan_id=stripe_price_id pairs.
PLAN_PRICE_IDS=plus_monthly=price_placeholder

# AI assistant
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_MAX_TOKENS=16000
